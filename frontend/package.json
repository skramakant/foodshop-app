{
  "name": "foodshop-frontend",
  "version": "1.0.0",
  "description": "Food Shop customer and admin portals — standalone frontend",
  "scripts": {
    "dev": "npx serve public -p 3000",
    "build": "npx tailwindcss -i src/css/input.css -o public/css/app.css --minify",
